# Servidor
PORT=4000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_postgres
DB_NAME=ecommerce_spotify_ui

# Autenticación
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Correo — ADMIN_EMAIL recibe el aviso de cada pedido nuevo
ADMIN_EMAIL=admin@mitienda.test
# (si SMTP_HOST está vacío se usa una cuenta Ethereal autogenerada)
MAIL_FROM="Mi Tienda" <no-reply@mitienda.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Datos de transferencia bancaria mostrados en el correo
BANK_NAME=Banco Ejemplo
BANK_BENEFICIARIO=Mi Tienda S.A. de C.V.
BANK_CLABE=000000000000000000
